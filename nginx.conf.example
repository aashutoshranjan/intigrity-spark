# Sample Nginx reverse-proxy config for Intigrityfactor Innovations
# Place at /etc/nginx/sites-available/intigrityfactor and symlink into sites-enabled.
# Replace yourdomain.com with your real domain.

server {
    listen 80;
    listen [::]:80;
    server_name yourdomain.com www.yourdomain.com;

    # Certbot will add the HTTPS server block and the redirect automatically.
    location / {
        proxy_pass http://127.0.0.1:3020;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
        proxy_read_timeout 60s;
    }

    # Long-lived caching for hashed build assets
    location /_build/ {
        proxy_pass http://127.0.0.1:3020;
        proxy_set_header Host $host;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    client_max_body_size 20M;
    gzip on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;
}
