# Port the Node server listens on (Nginx proxies to this)
PORT=3020

# Bind address for the Node server
HOST=0.0.0.0

# Public base URL of the site (used for canonical URLs, sitemap and OG tags)
SITE_URL=https://yourdomain.com

# Exposed to the browser build. Keep in sync with SITE_URL.
VITE_SITE_URL=https://yourdomain.com

# Optional: override the payment QR image path (defaults to /qr-code.png)
# VITE_QR_CODE_URL=/qr-code.png
